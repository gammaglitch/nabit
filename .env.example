POSTGRES_USER=nabit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nabit

# Sign-in. Generate the secret with `openssl rand -base64 32`. BETTER_AUTH_URL
# is the API's public URL; AUTH_TRUSTED_ORIGINS the web app's origin(s).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3001
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
# Only these emails can create an account; with none set, nobody can.
ALLOWED_EMAILS=
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Set both flags to false for a single-user deployment behind a trusted boundary.
# AUTH_REQUIRED=false
# NEXT_PUBLIC_AUTH_REQUIRED=false

# Override only when the browser should reach the API on a different public URL.
# NEXT_PUBLIC_API_URL=http://127.0.0.1:3001/trpc

# Only needed when using `compose.hosted-db.yml`.
# DATABASE_URL=postgresql://user:password@host:5432/database

# Where the API writes downloaded article images. Defaults to ./data/assets.
# ASSET_STORAGE_PATH=./data/assets

# Powers the reader's "Ask" panel (chat about the open article). Leave unset to
# keep the feature off — the endpoint then answers 503 and nothing else changes.
# Any OpenRouter model slug works; see https://openrouter.ai/models
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Only needed when using `compose.vpn.yml` (routes ingest-worker egress
# through Gluetun). Provider names: https://github.com/qdm12/gluetun-wiki
# VPN_SERVICE_PROVIDER=mullvad
# VPN_TYPE=wireguard

# WireGuard providers (VPN_TYPE=wireguard).
# WIREGUARD_PRIVATE_KEY=
# WIREGUARD_ADDRESSES=10.64.0.2/32
# WIREGUARD_PRESHARED_KEY=

# OpenVPN providers (VPN_TYPE=openvpn).
# OPENVPN_USER=
# OPENVPN_PASSWORD=

# Optional exit-server selection; leave unset to let the provider choose.
# Some scrape targets rate-limit shared VPN exit IPs, so pinning a country
# that works for your sources is often necessary.
# VPN_SERVER_COUNTRIES=Netherlands
# VPN_SERVER_CITIES=
# VPN_SERVER_HOSTNAMES=

# Private ranges the killswitch still allows, so the worker can reach `db`.
# Narrow this to the project's own subnet if you want a smaller hole.
# VPN_OUTBOUND_SUBNETS=172.16.0.0/12

# Static bearer token for the browser extension, Discord bot and scripts.
# API_TOKEN=
