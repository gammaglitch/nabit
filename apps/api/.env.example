HOST=0.0.0.0
PORT=3001
WEBSOCKETS_ENABLED=false
DATABASE_URL=
# Set to "false" for single-user / private-network deployments. Every request
# gets a synthetic admin user and ALLOWED_EMAILS is ignored. Defaults to "true".
# AUTH_REQUIRED=true
# Signs session tokens. Generate one with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# The API's public URL, and the web app origin(s) allowed to sign in.
BETTER_AUTH_URL=http://localhost:3001
AUTH_TRUSTED_ORIGINS=http://localhost:3002
# Comma-separated list of emails allowed to sign up and use the app. Without it
# nobody can create an account. Case-insensitive; applies to every route.
# API_TOKEN callers are not gated.
# ALLOWED_EMAILS=alice@example.com,bob@example.com
# Static API token for scripts/automation (e.g. Tampermonkey):
# API_TOKEN=
