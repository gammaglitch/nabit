# Build-time config for the extension. Copy to `.env`; WXT loads it and inlines
# every WXT_-prefixed var into the bundle.

# API the built extension talks to by default. Unset falls back to
# http://localhost:3001. The origin is added to host_permissions at build time,
# so no runtime permission prompt is needed for it. The popup's CONFIG panel
# still overrides this per install.
#
# Note this is the API host, not the web app: staging serves the Next.js app at
# memory.taida.space and Fastify at memory-api.taida.space (see the caddy
# labels in never-forgetti's compose.staging.yml). Pointing this at the web
# host gets you its login redirect, not the API.
WXT_API_URL=https://memory-api.taida.space

# Static API_TOKEN from the server's env (see the repo-root .env.example). Seeds
# the token field so a fresh install works without pasting it in.
#
# Leave empty for any build you hand out — whatever is set here is baked into
# the bundle, so don't `wxt zip` a build carrying a token you wouldn't share.
WXT_API_TOKEN=

# Used only by `wxt dev` to launch the browser; never reaches the bundle.
# CHROME_PATH=/usr/bin/google-chrome-stable
# CHROME_PROFILE=/home/you/.config/google-chrome-nabit
